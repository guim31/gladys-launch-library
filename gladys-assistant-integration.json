{
  "manifest_version": 1,
  "type": "device",
  "name": "Rocket Launches",
  "description": {
    "en": "Upcoming rocket launches worldwide: countdown, liftoff, results and delays for your scenes.",
    "fr": "Prochains lancements de fusées : compte à rebours, décollage, résultats et reports pour vos scènes.",
    "de": "Kommende Raketenstarts weltweit: Countdown, Start, Ergebnisse und Verschiebungen für Szenen.",
    "es": "Próximos lanzamientos de cohetes: cuenta atrás, despegue, resultados y aplazamientos para escenas."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-launch-library:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-launch-library/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Launches come from Launch Library 2 by The Space Devs, a free database without an account, limited to 15 requests per hour: the integration reads it every 30 minutes, every 10 minutes around a launch. Dates are shown in the Gladys time zone.",
        "fr": "Les lancements viennent de Launch Library 2 (The Space Devs), une base gratuite sans compte, limitée à 15 requêtes par heure : l'intégration la lit toutes les 30 minutes, toutes les 10 minutes autour d'un lancement. Heures dans le fuseau de Gladys.",
        "de": "Die Starts kommen aus Launch Library 2 von The Space Devs, einer kostenlosen Datenbank ohne Konto mit 15 Anfragen pro Stunde: Die Integration liest sie alle 30 Minuten, rund um einen Start alle 10 Minuten. Zeiten in der Zeitzone von Gladys.",
        "es": "Los lanzamientos vienen de Launch Library 2 (The Space Devs), una base gratuita sin cuenta, limitada a 15 solicitudes por hora: la integración la lee cada 30 minutos, cada 10 minutos cerca de un lanzamiento. Horas en la zona horaria de Gladys."
      },
      "links": [
        {
          "url": "https://thespacedevs.com/llapi",
          "label": {
            "en": "Launch Library 2",
            "fr": "Launch Library 2",
            "de": "Launch Library 2",
            "es": "Launch Library 2"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "display": "radio",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Language of the device and feature names, of the text values and of the scene sentences. Names are set when a device is created: to rename them, delete and re-add the device.",
        "fr": "Langue des noms d'appareils et de fonctionnalités, des valeurs textuelles et des phrases de scène. Les noms sont fixés à la création : pour les renommer, supprimez puis rajoutez l'appareil.",
        "de": "Sprache der Geräte- und Funktionsnamen, der Textwerte und der Szenensätze. Die Namen werden beim Anlegen festgelegt: Zum Umbenennen lösche das Gerät und füge es erneut hinzu.",
        "es": "Idioma de los nombres de dispositivos y funciones, de los valores de texto y de las frases de escena. Los nombres se fijan al crearlos: para cambiarlos, elimine el dispositivo y vuelva a añadirlo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "filters",
      "type": "string",
      "required": false,
      "default": "",
      "label": {
        "en": "Filters (one device each)",
        "fr": "Filtres (un appareil chacun)",
        "de": "Filter (je ein Gerät)",
        "es": "Filtros (un dispositivo cada uno)"
      },
      "description": {
        "en": "Up to 5, separated by commas: a provider (SpaceX, Arianespace, ISRO), a rocket (Ariane 6, Starship), a site (Kourou, Florida, Baikonur) or a country code (US, CN). Each filter adds a \"Next launch\" device of its own.",
        "fr": "Jusqu'à 5, séparés par des virgules : un opérateur (SpaceX, Arianespace, ISRO), une fusée (Ariane 6, Starship), un site (Kourou, Floride, Baïkonour) ou un code pays (US, CN). Chaque filtre ajoute son propre appareil « Prochain lancement ».",
        "de": "Bis zu 5, durch Kommas getrennt: ein Betreiber (SpaceX, Arianespace, ISRO), eine Rakete (Ariane 6, Starship), ein Ort (Kourou, Florida, Baikonur) oder ein Ländercode (US, CN). Jeder Filter fügt ein eigenes Gerät „Nächster Raketenstart“ hinzu.",
        "es": "Hasta 5, separados por comas: un operador (SpaceX, Arianespace, ISRO), un cohete (Ariane 6, Starship), un lugar (Kourou, Florida, Baikonur) o un código de país (US, CN). Cada filtro añade su propio dispositivo «Próximo lanzamiento»."
      },
      "placeholder": {
        "en": "SpaceX, Kourou",
        "fr": "SpaceX, Kourou",
        "de": "SpaceX, Kourou",
        "es": "SpaceX, Kourou"
      }
    }
  ],
  "actions": [
    {
      "key": "check",
      "label": {
        "en": "Check",
        "fr": "Vérifier",
        "de": "Prüfen",
        "es": "Comprobar"
      },
      "description": {
        "en": "Reads Launch Library 2 again now and shows the next launch, your filters and the requests left.",
        "fr": "Relit Launch Library 2 maintenant et affiche le prochain lancement, vos filtres et les requêtes restantes.",
        "de": "Liest Launch Library 2 jetzt neu und zeigt den nächsten Start, deine Filter und die verbleibenden Anfragen.",
        "es": "Vuelve a leer Launch Library 2 ahora y muestra el próximo lanzamiento, sus filtros y las solicitudes restantes."
      },
      "timeout_seconds": 60
    }
  ],
  "widgets": [
    {
      "key": "upcoming_launches",
      "label": {
        "en": "Rocket launches",
        "fr": "Lancements spatiaux",
        "de": "Raketenstarts",
        "es": "Lanzamientos espaciales"
      },
      "description": {
        "en": "Countdown to the next launch and the five next ones, worldwide or for a filter.",
        "fr": "Compte à rebours du prochain lancement et les cinq suivants, partout ou pour un filtre.",
        "de": "Countdown bis zum nächsten Start und die fünf nächsten, weltweit oder für einen Filter.",
        "es": "Cuenta atrás del próximo lanzamiento y los cinco siguientes, en todo el mundo o por filtro."
      },
      "icon": "navigation",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": false,
          "label": {
            "en": "Device",
            "fr": "Appareil",
            "de": "Gerät",
            "es": "Dispositivo"
          },
          "description": {
            "en": "Empty: every launch. Otherwise the device of a filter.",
            "fr": "Vide : tous les lancements. Sinon, l'appareil d'un filtre.",
            "de": "Leer: alle Starts. Sonst das Gerät eines Filters.",
            "es": "Vacío: todos los lanzamientos. Si no, el dispositivo de un filtro."
          }
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "launch_soon",
      "label": {
        "en": "Launch soon",
        "fr": "Lancement imminent",
        "de": "Start steht bevor",
        "es": "Lanzamiento inminente"
      },
      "description": {
        "en": "Fires before a launch whose time is known to the minute and confirmed (Go or to be confirmed), at the lead time chosen.",
        "fr": "Se déclenche avant un lancement dont l'heure est connue à la minute et confirmée (Go ou à confirmer), à l'avance choisie.",
        "de": "Löst vor einem Start aus, dessen Uhrzeit minutengenau bekannt und bestätigt ist (Go oder zu bestätigen), mit der gewählten Vorlaufzeit.",
        "es": "Se activa antes de un lanzamiento cuya hora se conoce al minuto y está confirmada (Go o por confirmar), con la antelación elegida."
      },
      "fields": [
        {
          "key": "device",
